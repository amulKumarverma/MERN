
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Data</title>
</head>

<body>



    <!-- Display student data -->
    <h2>Student List</h2>

    <table border="1">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            <% studentdata.forEach((data) => { %>
                <tr>
                    <td><%= data.name %></td>
                    <td><%= data.age %></td>
                    <td><%= data.email %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <button><a href="/">add student</a></button>

</body>
</html>